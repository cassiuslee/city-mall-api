<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.citymall.api.module.goods.mapper.GoodsPriceRuleMapper">

    <select id="selectBySpuId" resultType="com.citymall.api.module.goods.entity.GoodsPriceRule">
        select *
        from goods_price_rule
        where (f_delete_mark = 0 or f_delete_mark is null)
          and spu_id = #{spuId}
        limit 1
    </select>

</mapper>