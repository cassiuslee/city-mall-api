<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.citymall.api.module.customer.mapper.MarketTypesMapper">

    <!--
        查询所有启用的客户类型 en_code

        说明：
        1. 过滤逻辑删除
        2. 过滤空 en_code
    -->
    <select id="selectAllEnabledEnCode" resultType="java.lang.String">
        select en_code
        from market_types
        where (f_delete_mark = 0 or f_delete_mark is null)
          and en_code is not null
          and en_code != ''
        order by f_creator_time
    </select>

</mapper>